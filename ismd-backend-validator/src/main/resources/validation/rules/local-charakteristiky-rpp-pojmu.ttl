@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix slovníky: <https://slovník.gov.cz/generický/datový-slovník-ofn-slovníků/pojem/> .
@prefix a104: <https://slovník.gov.cz/agendový/104/pojem/> .
@prefix vsgov: <https://slovník.gov.cz/veřejný-sektor/pojem/> .
@prefix l111-2009: <https://slovník.gov.cz/legislativní/sbírka/111/2009/pojem/> .

# Info rule: RPP characteristics - Complete RPP information available
<https://slovník.gov.cz/shacl/lokální/pojem-má-kompletní-údaje-charakteristiky-rpp>
    a sh:NodeShape ;
    sh:targetClass slovníky:pojem ;
    sh:name "Kompletní údaje RPP charakteristik"@cs ;
    sh:description "Reports when concept has complete RPP characteristics" ;
    sh:message "Pojem má kompletní charakteristiky pro RPP"@cs ;
    sh:severity sh:Info ;

    sh:sparql [
        sh:select """
            PREFIX slovníky: <https://slovník.gov.cz/generický/datový-slovník-ofn-slovníků/pojem/>
            PREFIX vsgov: <https://slovník.gov.cz/veřejný-sektor/pojem/>
            PREFIX l111-2009: <https://slovník.gov.cz/legislativní/sbírka/111/2009/pojem/>
            PREFIX a104: <https://slovník.gov.cz/agendový/104/pojem/>

            SELECT $this
            WHERE {
                # 1. Must be shared in PPDF (value may be typed boolean true or the string "true")
                $this a104:je-sdílen-v-propojeném-datovém-fondu ?ppdfValue .
                FILTER(STR(?ppdfValue) = "true")

                # 2. Must be typ-subjektu-práva OR typ-objektu-práva
                {
                    $this a vsgov:typ-subjektu-práva .
                } UNION {
                    $this a vsgov:typ-objektu-práva .
                }

                # 3. If it's neveřejný-údaj, it must have ustanovení
                FILTER (
                    NOT EXISTS { $this a l111-2009:neveřejný-údaj . } ||
                    EXISTS {
                        $this a l111-2009:neveřejný-údaj .
                        $this l111-2009:je-vymezen-ustanovením-stanovujícím-jeho-neveřejnost ?ustanoveni .
                    }
                )
            }
        """ ;
    ] .

# Info rule: RPP characteristics - Missing PPDF sharing
<https://slovník.gov.cz/shacl/lokální/pojem-nemá-sdílení-v-rpp>
    a sh:NodeShape ;
    sh:targetClass slovníky:pojem ;
    sh:name "Charakteristiky RPP nemají údaje PPDF"@cs ;
    sh:description "Reports when concept doesn't have PPDF sharing" ;
    sh:message "Pojem nemá sdílení v propojeném datovém fondu"@cs ;
    sh:severity sh:Info ;

    sh:sparql [
        sh:select """
            PREFIX slovníky: <https://slovník.gov.cz/generický/datový-slovník-ofn-slovníků/pojem/>
            PREFIX vsgov: <https://slovník.gov.cz/veřejný-sektor/pojem/>
            PREFIX l111-2009: <https://slovník.gov.cz/legislativní/sbírka/111/2009/pojem/>
            PREFIX a104: <https://slovník.gov.cz/agendový/104/pojem/>

            SELECT $this
            WHERE {
                # Has typ-subjektu-práva OR typ-objektu-práva OR is veřejný/neveřejný údaj
                {
                    $this a vsgov:typ-subjektu-práva .
                } UNION {
                    $this a vsgov:typ-objektu-práva .
                } UNION {
                    $this a l111-2009:veřejný-údaj .
                } UNION {
                    $this a l111-2009:neveřejný-údaj .
                }

                # But is not shared in PPDF (value may be typed boolean true or the string "true")
                FILTER (
                    NOT EXISTS {
                        $this a104:je-sdílen-v-propojeném-datovém-fondu ?ppdfValue .
                        FILTER(STR(?ppdfValue) = "true")
                    }
                )
            }
        """ ;
    ] .

# Info rule: RPP characteristics - Missing legal provision for non-public information
<https://slovník.gov.cz/shacl/lokální/pojem-neveřejný-údaj-nemá-ustanovení-dokládající-neveřejnost>
    a sh:NodeShape ;
    sh:targetClass slovníky:pojem ;
    sh:name "Charakteristiky RPP nemají ustanovení dokládající neveřejnost"@cs ;
    sh:description "Reports when neveřejný údaj is missing ustanovení dokládající neveřejnost" ;
    sh:message "Pojem neveřejný údaj nemá ustanovení dokládající neveřejnost"@cs ;
    sh:severity sh:Info ;

    sh:sparql [
        sh:select """
            PREFIX slovníky: <https://slovník.gov.cz/generický/datový-slovník-ofn-slovníků/pojem/>
            PREFIX vsgov: <https://slovník.gov.cz/veřejný-sektor/pojem/>
            PREFIX l111-2009: <https://slovník.gov.cz/legislativní/sbírka/111/2009/pojem/>

            SELECT $this
            WHERE {
                # Is neveřejný údaj
                $this a l111-2009:neveřejný-údaj .

                # But does not have ustanovení dokládající neveřejnost
                FILTER (
                    NOT EXISTS {
                        $this l111-2009:je-vymezen-ustanovením-stanovujícím-jeho-neveřejnost ?ustanoveni .
                    }
                )
            }
        """ ;
    ] .

# Info rule: RPP characteristics - Does not have agenda relationship
<https://slovník.gov.cz/shacl/lokální/pojem-nemá-vztah-k-agendě-nebo-ais>
    a sh:NodeShape ;
    sh:targetClass slovníky:pojem ;
    sh:name "Charakteristiky RPP a Agend"@cs ;
    sh:description "Reports when concept does not have agenda or AIS relationships" ;
    sh:message "Pojem nemá vztah k agendě nebo AIS"@cs ;
    sh:severity sh:Info ;

    sh:sparql [
        sh:select """
            PREFIX slovníky: <https://slovník.gov.cz/generický/datový-slovník-ofn-slovníků/pojem/>
            PREFIX vsgov: <https://slovník.gov.cz/veřejný-sektor/pojem/>
            PREFIX l111-2009: <https://slovník.gov.cz/legislativní/sbírka/111/2009/pojem/>
            PREFIX a104: <https://slovník.gov.cz/agendový/104/pojem/>

            SELECT $this
            WHERE {
                $this a slovníky:pojem .

                # Flag only when the concept lacks both an agenda and an AIS relationship.
                FILTER NOT EXISTS {
                    $this a104:sdružuje-údaje-vedené-nebo-vytvářené-v-rámci-agendy ?agenda .
                }
                FILTER NOT EXISTS {
                    $this a104:údaje-jsou-v-ais ?ais .
                }
            }
        """ ;
    ] .