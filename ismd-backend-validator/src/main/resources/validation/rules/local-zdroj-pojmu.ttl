@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix slovníky: <https://slovník.gov.cz/generický/datový-slovník-ofn-slovníků/pojem/> .

# Warning rule: Concept should have a defining source (legislative or non-legislative).
# dct:source / dc:source are accepted as legacy forms.
<https://slovník.gov.cz/shacl/lokální/pojem-nemá-zdroj>
    a sh:NodeShape ;
    sh:targetClass slovníky:pojem ;
    sh:name "Zdroj pojmu"@cs ;
    sh:description "Ensures that each concept has a defining source" ;
    sh:message "Pojem nemá vyplněný zdroj"@cs ;
    sh:severity sh:Warning ;

    sh:or (
        [ sh:path slovníky:definující-ustanovení ; sh:minCount 1 ]
        [ sh:path slovníky:definující-nelegislativní-zdroj ; sh:minCount 1 ]
        [ sh:path dct:source ; sh:minCount 1 ]
        [ sh:path dc:source ; sh:minCount 1 ]
    ) .
